MONGO_URI=mongodb://mongo:27017/recon_db
DJANGO_SECRET_KEY=remplacer-par-une-cle-aleatoire-longue
DEBUG=True
AGENT_TOKEN=change-me
SCAN_ALLOWED_SUBNET=192.168.56.0/24
REACT_APP_ADMIN_USER=root
REACT_APP_ADMIN_PASSWORD=change-me
REACT_APP_API_URL=http://localhost:8000
REACT_APP_WS_URL=ws://localhost:8000

# Channels / live streaming
REDIS_URL=redis://redis:6379/0
# Set to "memory" only for tests (live streaming from worker threads will not work)
CHANNEL_LAYER_BACKEND=redis

# Operator auth (empty = dev bypass; set to require a token on scan/attack + WS)
API_AUTH_TOKEN=
REACT_APP_API_TOKEN=

# IDS thresholds
IDS_SWEEP_THRESHOLD=10
IDS_SWEEP_WINDOW=10
IDS_SYN_THRESHOLD=200
IDS_SYN_WINDOW=10
ALERT_COOLDOWN_SECONDS=10

# IPS response layer (false = record "would block" only; enforcement is lab-only)
IPS_ENFORCE=false

# Classic-ML scoring + triage (off by default; needs ml/ + ml/requirements.txt + artifacts)
ML_ENABLED=false
ML_CONFIDENCE_THRESHOLD=0.7
ML_MIN_PACKETS=20
ML_WINDOW_SECONDS=10
ML_SCORE_INTERVAL=2
